# Dev Center security
# Optional read-only billing transaction analytics (Partner API View financials).
# Partner app GID is NOT the OAuth client_id. Keep token server-side only.
SHOPIFY_PARTNER_ORGANIZATION_ID=
SHOPIFY_PARTNER_APP_ID=
SHOPIFY_PARTNER_ACCESS_TOKEN=

DEV_SESSION_SECRET=
DEV_TOTP_ENCRYPTION_KEY=
DEV_ALLOWED_ORIGINS=

# Legacy Dev Dashboard allowlist is no longer used for Dev Center authorization.
# AI_SEARCH_DEV_DASHBOARD_ENABLED=
# AI_SEARCH_DEV_ADMIN_SHOPS=

# Query analysis / semantic expansion. Gemini is primary; OpenAI is an
# optional one-shot backup for Gemini quota/timeout/5xx/network failures.
GEMINI_API_KEY=
GEMINI_QUERY_REWRITE_MODEL=gemini-3.5-flash-lite
OPENAI_QUERY_REWRITE_MODEL=gpt-6-luna
GEMINI_QUERY_SIMPLE_THINKING_BUDGET=0
GEMINI_QUERY_COMPLEX_THINKING_BUDGET=0
GEMINI_QUERY_THINKING_LEVEL=minimal
AI_SEARCH_LLM_TIMEOUT_MS=1500
AI_SEARCH_LLM_SIMPLE_TIMEOUT_MS=4000
AI_SEARCH_LLM_COMPLEX_TIMEOUT_MS=5000
AI_SEARCH_FULL_RESULT_CACHE_TTL_MS=86400000
AI_SEARCH_RECEIPT_TTL_MS=7200000
AI_SEARCH_QUERY_FALLBACK_CACHE_TTL_MS=3000
AI_SEARCH_QUERY_EMBEDDING_TIMEOUT_MS=5000
AI_SEARCH_QUERY_EMBEDDING_MAX_RETRIES=1
AI_SEARCH_TRANSIENT_FALLBACK_VECTOR_SCORE_THRESHOLD=0.18
AI_SEARCH_TRANSIENT_FALLBACK_NO_EVIDENCE_MIN_TOP_SCORE=0.27
# LLM-success DIRECT/DISCOVERY queries without strong catalog evidence need
# this raw top-vector score before results are shown (0..1).
AI_SEARCH_NO_EVIDENCE_MIN_TOP_SCORE=0.50
AI_SEARCH_DISCOVERY_VECTOR_SCORE_THRESHOLD=0.24
AI_SEARCH_DISCOVERY_VECTOR_RELATIVE_SCORE_RATIO=0.88
# When a grounded DISCOVERY query would otherwise return too few vector hits,
# relax only enough to retain this many candidates before later reranking.
AI_SEARCH_DISCOVERY_MIN_RECALL_RESULTS=8
AI_SEARCH_VECTOR_SCORE_THRESHOLD=0.35
GEMINI_QUERY_INPUT_USD_PER_1M=0.25
GEMINI_QUERY_CACHED_INPUT_USD_PER_1M=0.025
GEMINI_QUERY_OUTPUT_USD_PER_1M=1.50

# Product enrichment remains on OpenAI and is intentionally independent from
# the query rewrite provider/model.
OPENAI_PRODUCT_ENRICHMENT_MODEL=gpt-6-luna

# Qdrant hybrid-search storage. QDRANT_COLLECTION is the legacy/base name;
# v9 derives a new schema-safe collection such as
# ai_search_products_v9_1536_bm25. Set QDRANT_COLLECTION_V9 only when an
# explicit collection name is required.
QDRANT_COLLECTION=ai_search_products
QDRANT_COLLECTION_V9=

# Background runtime. Use `all` for a single container. When scaling, run web
# replicas with `web` and one durable worker replica with `worker`.
AI_SEARCH_PROCESS_ROLE=all
AI_SEARCH_BACKGROUND_WORKERS_ENABLED=true
AI_SEARCH_SYNC_QUEUE_POLL_MS=60000
AI_SEARCH_CATALOG_QUEUE_POLL_MS=60000
AI_SEARCH_CATALOG_QUEUE_START_DELAY_MS=5000
AI_SEARCH_CATALOG_PRODUCT_CONCURRENCY=3
AI_SEARCH_LEASE_CLEANUP_MS=600000
AI_SEARCH_HOUSEKEEPING_INTERVAL_MS=21600000
AI_SEARCH_HOUSEKEEPING_INITIAL_DELAY_MS=120000
AI_SEARCH_HOUSEKEEPING_DELETE_BATCH_SIZE=5000
AI_SEARCH_HOUSEKEEPING_MAX_DELETE_BATCHES=20
AI_SEARCH_USAGE_EVENT_RETENTION_DAYS=90
AI_SEARCH_QUERY_LOG_RETENTION_DAYS=90
AI_SEARCH_SYNC_JOB_RETENTION_DAYS=30
AI_SEARCH_CATALOG_JOB_RETENTION_DAYS=90
AI_SEARCH_FAILED_SYNC_JOB_RETENTION_DAYS=90
AI_SEARCH_FAILED_CATALOG_JOB_RETENTION_DAYS=180
AI_SEARCH_USAGE_RESERVATION_RETENTION_DAYS=7
AI_SEARCH_API_USAGE_EVENT_RETENTION_DAYS=7
AI_SEARCH_API_USAGE_DAILY_RETENTION_DAYS=730
AI_SEARCH_ENRICHMENT_RETRY_BATCH_SIZE=100
AI_SEARCH_DEV_AUTH_RETENTION_DAYS=7
AI_SEARCH_AUDIT_RETENTION_DAYS=365
AI_SEARCH_ANALYTICS_MAX_EVENTS=20000
AI_SEARCH_CATALOG_REVISION_CACHE_TTL_MS=2000
# Revision-aware dictionary/context caches use a long safety TTL; catalogRevision
# invalidates them immediately in-process and within ~2s across processes.
AI_SEARCH_DICTIONARY_CACHE_TTL_MS=21600000
AI_SEARCH_SHOP_CONTEXT_CACHE_TTL_MS=21600000
AI_SEARCH_SEMANTIC_PROFILE_CACHE_TTL_MS=21600000
AI_SEARCH_SEMANTIC_PROFILE_LOAD_BATCH_SIZE=500
AI_SEARCH_SEMANTIC_CACHE_MAX_ROWS=250000
AI_SEARCH_SEMANTIC_CACHE_MAX_TOTAL_ROWS=500000
AI_SEARCH_SEMANTIC_PAYLOAD_BACKFILL_PER_RUN=1000
AI_SEARCH_SEMANTIC_PAYLOAD_BACKFILL_CONCURRENCY=10
AI_SEARCH_SHOP_CONTEXT_CACHE_MAX_TOTAL_TERMS=250000
AI_SEARCH_TRANSPORT_PROFILE_CACHE_TTL_MS=300000
AI_SEARCH_TRANSPORT_CACHE_MAX_SIGNATURES=500000

AI_SEARCH_PRODUCT_LLM_MAX_OUTPUT_TOKENS=1600
AI_SEARCH_PRODUCT_LLM_RETRY_MAX_OUTPUT_TOKENS=2200
AI_SEARCH_PRODUCT_LLM_TIMEOUT_MS=12000
AI_SEARCH_PRODUCT_LLM_RETRY_TIMEOUT_MS=20000
# Telemetry outbox must reside on persistent storage in deployment.
AI_SEARCH_TELEMETRY_OUTBOX_DIR=.data/telemetry-outbox
# Explicit provider:model rates in USD / million tokens; missing rates are UNKNOWN.
AI_SEARCH_MODEL_COST_RATES_JSON={}
