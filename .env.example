# Dev Center security
DEV_SESSION_SECRET=
DEV_TOTP_ENCRYPTION_KEY=
DEV_ALLOWED_ORIGINS=

# Legacy Dev Dashboard allowlist is no longer used for Dev Center authorization.
# AI_SEARCH_DEV_DASHBOARD_ENABLED=
# AI_SEARCH_DEV_ADMIN_SHOPS=

# Query analysis / semantic expansion (Google Gemini only)
GEMINI_API_KEY=
GEMINI_QUERY_REWRITE_MODEL=gemini-3.5-flash-lite
GEMINI_QUERY_SIMPLE_THINKING_BUDGET=0
GEMINI_QUERY_COMPLEX_THINKING_BUDGET=0
GEMINI_QUERY_THINKING_LEVEL=minimal
AI_SEARCH_LLM_TIMEOUT_MS=1500
AI_SEARCH_LLM_SIMPLE_TIMEOUT_MS=4000
AI_SEARCH_LLM_COMPLEX_TIMEOUT_MS=5000
AI_SEARCH_FULL_RESULT_CACHE_TTL_MS=86400000
AI_SEARCH_RECEIPT_TTL_MS=7200000
AI_SEARCH_QUERY_FALLBACK_CACHE_TTL_MS=3000
AI_SEARCH_TRANSIENT_FALLBACK_VECTOR_SCORE_THRESHOLD=0.18
AI_SEARCH_TRANSIENT_FALLBACK_NO_EVIDENCE_MIN_TOP_SCORE=0.27
# LLM-success DIRECT/DISCOVERY queries without strong catalog evidence need
# this raw top-vector score before results are shown (0..1).
AI_SEARCH_NO_EVIDENCE_MIN_TOP_SCORE=0.45
AI_SEARCH_DISCOVERY_VECTOR_SCORE_THRESHOLD=0.24
AI_SEARCH_DISCOVERY_VECTOR_RELATIVE_SCORE_RATIO=0.88
# When a grounded DISCOVERY query would otherwise return too few vector hits,
# relax only enough to retain this many candidates before later reranking.
AI_SEARCH_DISCOVERY_MIN_RECALL_RESULTS=8
AI_SEARCH_VECTOR_SCORE_THRESHOLD=0.35
GEMINI_QUERY_INPUT_USD_PER_1M=0.25
GEMINI_QUERY_CACHED_INPUT_USD_PER_1M=0.025
GEMINI_QUERY_OUTPUT_USD_PER_1M=1.50

# Product enrichment remains on OpenAI and is intentionally independent from
# the query rewrite provider/model.
OPENAI_PRODUCT_ENRICHMENT_MODEL=gpt-6-luna


# Background runtime. Use `all` for a single container. When scaling, run web
# replicas with `web` and one durable worker replica with `worker`.
AI_SEARCH_PROCESS_ROLE=all
AI_SEARCH_BACKGROUND_WORKERS_ENABLED=true
AI_SEARCH_SYNC_QUEUE_POLL_MS=60000
AI_SEARCH_CATALOG_QUEUE_POLL_MS=60000
AI_SEARCH_CATALOG_QUEUE_START_DELAY_MS=5000
AI_SEARCH_LEASE_CLEANUP_MS=600000
AI_SEARCH_HOUSEKEEPING_INTERVAL_MS=21600000
AI_SEARCH_HOUSEKEEPING_INITIAL_DELAY_MS=120000

AI_SEARCH_PRODUCT_LLM_MAX_OUTPUT_TOKENS=1600
AI_SEARCH_PRODUCT_LLM_RETRY_MAX_OUTPUT_TOKENS=2200
AI_SEARCH_PRODUCT_LLM_TIMEOUT_MS=12000
AI_SEARCH_PRODUCT_LLM_RETRY_TIMEOUT_MS=20000
