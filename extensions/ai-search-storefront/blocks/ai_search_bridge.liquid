{% comment %}
  AI Search Bridge V4

  Early boot:
  - Chạy trong <head> trước khi storefront body được paint.
  - Chỉ kích hoạt trên /search có query.
  - Không kích hoạt khi đang native fallback.
  - Mục tiêu: không để Shopify native search ló ra trước AI Search V4.

  Runtime:
  - search-interceptor.v4.js vẫn chịu trách nhiệm:
    + semantic search
    + receipt
    + Theme Map V4 render
    + pagination
    + result count
    + click telemetry
    + fallback
{% endcomment %}

<style>
  /*
   * Chỉ áp dụng trong lần boot đầu của AI Search.
   *
   * Native HTML vẫn được Shopify SSR bình thường,
   * nhưng chưa được phép paint ra màn hình trước
   * khi AI Search V4 hoàn thành.
   */
  html[data-ai-search-v4-early-boot="pending"] body {
    visibility: hidden;
  }

  /*
   * search-interceptor.v4.js tạo loading layer này.
   *
   * Cho phép loading layer hiện ra dù body đang
   * bị visibility:hidden.
   */
  html[data-ai-search-v4-early-boot="pending"]
    [data-ai-search-v4-loading] {
    visibility: visible;
  }
</style>

<script>
  (function () {
    "use strict";

    var pathname =
      window.location.pathname || "";

    var isSearchPage =
      /\/search\/?$/.test(pathname);

    if (!isSearchPage) {
      return;
    }

    var params =
      new URLSearchParams(
        window.location.search
      );

    var query =
      (
        params.get("q") ||
        ""
      ).trim();

    var bypass =
      params.get(
        "_ai_search_bypass"
      ) === "1";

    /*
     * Không có query:
     * để theme render search page bình thường.
     *
     * Native fallback:
     * tuyệt đối không che kết quả native.
     */
    if (
      !query ||
      bypass
    ) {
      return;
    }

    var root =
      document.documentElement;

    root.setAttribute(
      "data-ai-search-v4-early-boot",
      "pending"
    );

    /*
     * Đồng bộ với loading contract hiện có của V4.
     *
     * search-interceptor.v4.js:
     * - showLoading() => aria-busy=true
     * - hideLoading() => remove aria-busy
     */
    root.setAttribute(
      "aria-busy",
      "true"
    );

    /*
     * Khi V4 hoàn tất hoặc kết thúc loading,
     * hideLoading() sẽ remove aria-busy.
     *
     * Observer dùng tín hiệu đó để gỡ early boot
     * mà không cần phụ thuộc selector của theme.
     */
    var observer =
      new MutationObserver(
        function () {
          if (
            !root.hasAttribute(
              "aria-busy"
            )
          ) {
            root.removeAttribute(
              "data-ai-search-v4-early-boot"
            );

            observer.disconnect();
          }
        }
      );

    observer.observe(
      root,
      {
        attributes: true,
        attributeFilter: [
          "aria-busy"
        ]
      }
    );

    /*
     * Fail-safe:
     *
     * Nếu asset JS không tải được hoặc có lỗi
     * nghiêm trọng trước khi V4 khởi động,
     * không để storefront bị ẩn vô thời hạn.
     *
     * 45 giây đủ rộng hơn timeout AI hiện tại.
     */
    window.setTimeout(
      function () {
        if (
          root.getAttribute(
            "data-ai-search-v4-early-boot"
          ) !== "pending"
        ) {
          return;
        }

        console.warn(
          "[AI SEARCH V4] early boot fail-safe released"
        );

        root.removeAttribute(
          "data-ai-search-v4-early-boot"
        );

        root.removeAttribute(
          "aria-busy"
        );

        observer.disconnect();
      },
      45000
    );
  })();
</script>

<script>
  window.AI_SEARCH_CONFIG = {
    version: 4,
    theme_map_version: 4,
    theme_id: {{ theme.id | json }},
    search_url: {{ routes.search_url | json }},
    search_endpoint: {{ block.settings.proxy_path | default: "/apps/ai-search" | json }},
    unscopedSearchMode: {{ block.settings.unscoped_search_mode | json }}
  };
</script>

<script
  src="{{ 'search-interceptor.v4.js' | asset_url }}"
  defer
></script>

{% schema %}
{
  "name": "AI Search Bridge",
  "target": "head",
  "settings": [
    {
      "type": "select",
      "id": "unscoped_search_mode",
      "label": "Searches without an explicit resource type",
      "default": "product_only",
      "options": [
        {
          "value": "product_only",
          "label": "Use AI as product-only search (recommended)"
        },
        {
          "value": "respect_store",
          "label": "Respect store search types"
        }
      ]
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/ai-search"
    }
  ]
}
{% endschema %}