// AI Search Bridge - Prisma schema
// Production database: MySQL.
// DATABASE_URL is supplied through the environment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id @db.VarChar(191)
  shop                String    @db.VarChar(191)
  state               String    @db.VarChar(255)
  isOnline            Boolean   @default(false)
  scope               String?   @db.Text
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?   @db.VarChar(255)
  lastName            String?   @db.VarChar(255)
  email               String?   @db.VarChar(320)
  accountOwner        Boolean   @default(false)
  locale              String?   @db.VarChar(32)
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?   @db.Text
  refreshTokenExpires DateTime?
}

model AiSearchSyncJob {
  id          Int       @id @default(autoincrement())
  shop        String    @db.VarChar(191)
  webhookId   String    @unique @db.VarChar(191)
  topic       String    @db.VarChar(191)
  productId   String    @db.VarChar(64)
  status      String    @default("PENDING") @db.VarChar(64)
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([shop, productId])
}

model AiSearchLeaseLock {
  shop       String   @db.VarChar(191)
  resource   String   @db.VarChar(191)
  ownerToken String   @db.VarChar(191)
  leaseUntil DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([shop, resource])
  @@index([leaseUntil])
}

// =====================================================
// COMMERCIAL / MULTI-TENANT LAYER
// =====================================================

model AiSearchShop {
  shop          String    @id @db.VarChar(191)
  shopifyShopId String?   @db.VarChar(191)
  status        String    @default("ACTIVE") @db.VarChar(64)
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription      AiSearchSubscription?
  settings          AiSearchShopSettings?
  usagePeriods      AiSearchUsagePeriod[]
  usageEvents       AiSearchUsageEvent[]
  usageReservations AiSearchUsageReservation[]
  queryLogs         AiSearchQueryLog[]
  products          AiSearchIndexedProduct[]
  catalogJobs       AiSearchCatalogSyncJob[]
}

model AiSearchSubscription {
  id                    Int       @id @default(autoincrement())
  shop                  String    @unique @db.VarChar(191)
  plan                  String    @default("NONE") @db.VarChar(64)
  status                String    @default("INACTIVE") @db.VarChar(64)
  planHandle            String?   @db.VarChar(191)
  shopifySubscriptionId String?   @db.VarChar(191)
  billingPeriodStart    DateTime?
  billingPeriodEnd      DateTime?
  source                String    @default("LOCAL") @db.VarChar(64)
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shopRecord AiSearchShop @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@index([plan, status])
}

model AiSearchShopSettings {
  searchLanguage            String?  @db.VarChar(32)
  shop                      String   @id @db.VarChar(191)
  aiSearchEnabled           Boolean  @default(true)
  customDataModeEnabled     Boolean  @default(false)
  fallbackEnabled           Boolean  @default(true)
  productLimitOverride      Int?
  searchLimitOverride       Int?
  vectorUpdateLimitOverride Int?
  resultLimit               Int      @default(20)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  shopRecord AiSearchShop @relation(fields: [shop], references: [shop], onDelete: Cascade)
}

model AiSearchUsagePeriod {
  id                    Int      @id @default(autoincrement())
  shop                  String   @db.VarChar(191)
  periodKey             String   @db.VarChar(64)
  periodStart           DateTime
  periodEnd             DateTime
  searchCount           Int      @default(0)
  vectorUpdateCount     Int      @default(0)
  productIndexCount     Int      @default(0)
  productDeleteCount    Int      @default(0)
  queryEmbeddingCount   Int      @default(0)
  productEmbeddingCount Int      @default(0)
  fallbackCount         Int      @default(0)
  blockedSearchCount    Int      @default(0)
  blockedVectorCount    Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  shopRecord   AiSearchShop               @relation(fields: [shop], references: [shop], onDelete: Cascade)
  events       AiSearchUsageEvent[]
  reservations AiSearchUsageReservation[]

  @@unique([shop, periodKey])
  @@index([shop, periodStart, periodEnd])
}

model AiSearchUsageEvent {
  id           Int      @id @default(autoincrement())
  shop         String   @db.VarChar(191)
  periodId     Int?
  type         String   @db.VarChar(64)
  quantity     Int      @default(1)
  success      Boolean  @default(true)
  productId    String?  @db.VarChar(64)
  queryHash    String?  @db.VarChar(64)
  jobId        Int?
  metadataJson String?  @db.LongText
  createdAt    DateTime @default(now())

  shopRecord AiSearchShop         @relation(fields: [shop], references: [shop], onDelete: Cascade)
  period     AiSearchUsagePeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@index([shop, type, createdAt])
  @@index([periodId, createdAt])
}

model AiSearchQueryLog {
  id                  String   @id @default(cuid()) @db.VarChar(191)
  shop                String   @db.VarChar(191)
  query               String   @db.Text
  normalizedQuery     String   @db.VarChar(500)
  queryHash           String   @db.VarChar(64)
  queryVectorJson     String?  @db.LongText
  analyzedQuery       String?  @db.Text
  llmAnalysisJson     String?  @db.LongText
  selectedContextJson String?  @db.LongText
  rankedProductsJson  String   @db.LongText
  resultCount         Int      @default(0)
  candidateCount      Int      @default(0)
  topScore            Float?
  topCandidateScore   Float?
  vectorThreshold     Float
  embeddingCacheHit   Boolean  @default(false)
  llmStatus           String   @db.VarChar(64)
  llmFallbackReason   String?  @db.Text
  totalDurationMs     Int
  createdAt           DateTime @default(now())

  shopRecord AiSearchShop         @relation(fields: [shop], references: [shop], onDelete: Cascade)
  clicks     AiSearchQueryClick[]

  @@index([shop, createdAt])
  @@index([shop, normalizedQuery, createdAt])
  @@index([shop, resultCount, createdAt])
}

model AiSearchQueryClick {
  id          Int      @id @default(autoincrement())
  searchLogId String   @db.VarChar(191)
  shop        String   @db.VarChar(191)
  productId   String   @db.VarChar(64)
  rank        Int
  score       Float?
  createdAt   DateTime @default(now())

  searchLog AiSearchQueryLog @relation(fields: [searchLogId], references: [id], onDelete: Cascade)

  @@unique([searchLogId, productId])
  @@index([shop, createdAt])
  @@index([searchLogId, createdAt])
}

model AiSearchUsageReservation {
  id                  String    @id @db.VarChar(191)
  shop                String    @db.VarChar(191)
  periodId            Int
  kind                String    @db.VarChar(64)
  status              String    @default("PENDING") @db.VarChar(64)
  countsVectorUpdate  Boolean   @default(false)
  productId           String?   @db.VarChar(64)
  queryHash           String?   @db.VarChar(64)
  embeddingConsumedAt DateTime?
  effectAppliedAt     DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shopRecord AiSearchShop        @relation(fields: [shop], references: [shop], onDelete: Cascade)
  period     AiSearchUsagePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([shop, status, createdAt])
  @@index([status, createdAt])
  @@index([shop, status, updatedAt])
  @@index([status, updatedAt])
  @@index([status, resolvedAt])
  @@index([periodId, status])
}

model AiSearchIndexedProduct {
  id                Int       @id @default(autoincrement())
  shop              String    @db.VarChar(191)
  productId         String    @db.VarChar(64)
  handle            String    @db.VarChar(255)
  title             String    @db.VarChar(255)
  status            String    @default("INDEXED") @db.VarChar(64)
  hasVector         Boolean   @default(false)
  documentHash      String?   @db.VarChar(64)
  lastIndexedAt     DateTime?
  lastSeenAt        DateTime  @default(now())
  lastCatalogSeenAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shopRecord   AiSearchShop              @relation(fields: [shop], references: [shop], onDelete: Cascade)
  contextTerms AiSearchShopContextTerm[]

  @@unique([shop, productId])
  @@index([shop, status])
  @@index([shop, handle])
  @@index([shop, lastCatalogSeenAt])
}

// Background initial catalog sync. One shop can keep history, but only one
// PENDING/PROCESSING job is created by the service at a time.
model AiSearchCatalogSyncJob {
  id                Int       @id @default(autoincrement())
  shop              String    @db.VarChar(191)
  reason            String    @default("INITIAL") @db.VarChar(64)
  planAtStart       String?   @db.VarChar(64)
  status            String    @default("PENDING") @db.VarChar(64)
  cursor            String?   @db.Text
  pagesProcessed    Int       @default(0)
  productsProcessed Int       @default(0)
  productsIndexed   Int       @default(0)
  productsSkipped   Int       @default(0)
  productsBlocked   Int       @default(0)
  productsFailed    Int       @default(0)
  attempts          Int       @default(0)
  lastError         String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // Stable timestamp for one logical full-catalog scan. Unlike startedAt,
  // this is not reset on retry/reclaim and is used for stale-entry cleanup.
  scanStartedAt     DateTime?
  startedAt         DateTime?
  processedAt       DateTime?

  shopRecord AiSearchShop @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@index([shop, status, createdAt])
  @@index([status, createdAt])
  @@index([status, updatedAt])
}

model ShopThemeConfig {
  shop            String   @id @db.VarChar(191)
  themeId         String   @db.VarChar(64)
  appEmbedEnabled Boolean  @default(true)
  activeThemeJson String   @db.LongText
  themeMapJson    String   @db.LongText
  updatedAt       DateTime @updatedAt
}

// =====================================================
// THEME MAP V4 - PERSISTENT PER SHOP / MAIN THEME
// =====================================================
//
// mapJson is the latest map attempt for the current theme snapshot.
// verifiedMapJson preserves the last VERIFIED map even when a later rebuild
// becomes UNSUPPORTED. The lifecycle never renders a stale verified backup;
// it is retained only for recovery/debug/rollback tooling.
model AiSearchThemeMapV4 {
  id               Int     @id @default(autoincrement())
  shop             String  @db.VarChar(191)
  themeId          String  @db.VarChar(64)
  themeGid         String  @db.VarChar(191)
  themeName        String? @db.VarChar(255)
  schemaVersion    Int     @default(4)
  mapStatus        String  @db.VarChar(64)
  sourceMode       String  @default("COMPILER") @db.VarChar(64)
  themeVersionKey  String  @db.VarChar(255)
  fingerprint      String  @db.VarChar(64)
  mapJson          String  @db.LongText
  dependenciesJson String  @db.LongText
  failureReason    String? @db.Text

  verifiedThemeVersionKey  String? @db.VarChar(255)
  verifiedFingerprint      String? @db.VarChar(64)
  verifiedMapJson          String? @db.LongText
  verifiedDependenciesJson String? @db.LongText

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastValidatedAt DateTime?
  lastUsedAt      DateTime?

  @@unique([shop, themeId])
  @@index([shop, mapStatus])
  @@index([shop, updatedAt])
}

model AiSearchResultReceipt {
  receiptId          String   @id @db.VarChar(191)
  shop               String   @db.VarChar(191)
  query              String   @db.Text
  searchLogId        String?  @db.VarChar(191)
  rankedProductsJson String   @db.LongText
  total              Int
  createdAt          DateTime @default(now())
  expiresAt          DateTime

  @@index([shop, expiresAt])
  @@index([expiresAt])
}

// Semantic vocabulary built only while products are synchronized. Search-time
// code reads this compact index instead of sending catalog data to the query LLM.
model AiSearchShopContextTerm {
  id              Int      @id @default(autoincrement())
  shop            String   @db.VarChar(191)
  productId       String   @db.VarChar(64)
  kind            String   @db.VarChar(64)
  value           String   @db.VarChar(255)
  normalizedValue String   @db.VarChar(255)
  createdAt       DateTime @default(now())

  productRecord AiSearchIndexedProduct @relation(fields: [shop, productId], references: [shop, productId], onDelete: Cascade)

  @@unique([shop, productId, kind, normalizedValue])
  @@index([shop, kind])
  @@index([shop, normalizedValue])
}

model AiSearchRenderTransportKey {
  id Int @id @default(autoincrement())

  shop      String @db.VarChar(191)
  productId String @db.VarChar(64)

  /**
   * Loại signature.
   * VARIANT_SKU
   * VARIANT_BARCODE
   * TITLE_ONLY
   * TITLE_VENDOR
   * TITLE_PRODUCT_TYPE
   * TITLE_VENDOR_PRODUCT_TYPE
   * TITLE_VENDOR_PRODUCT_TYPE_TAG
   */
  kind String @db.VarChar(64)

  /**
   * Giá trị canonical dùng để so unique giữa các product.
   * Ví dụ:
   * selling plans ski wax\u001fadd-get-d-test\u001faccessories
   */
  signature String @db.VarChar(400)

  /**
   * Shopify Storefront Search clause đã compile sẵn.
   * Ví dụ:
   * (title:"Selling Plans Ski Wax"
   * AND vendor:"add-get-d-test"
   * AND product_type:"accessories")
   */
  clause String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, productId, kind, signature])
  /**
   * Runtime dùng index này để hỏi:
   * signature X thuộc bao nhiêu product?
   * Nếu đúng 1 owner => safe transport key.
   */
  @@index([shop, kind, signature])
  /**
   * Lấy toàn bộ candidate key của một AI product.
   */
  @@index([shop, productId])
}
